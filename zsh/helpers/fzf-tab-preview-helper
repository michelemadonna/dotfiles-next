#!/usr/bin/env zsh

# ============================================================
# Dependencies
# ============================================================
#
# macOS:
#
#   brew install \
#       fzf \
#       bat \
#       eza \
#       chafa \
#       mediainfo \
#       sevenzip \
#       poppler \
#       tree \
#       file \
#       bind \
#       fd
#
# Ubuntu / Debian / Kali:
#
#   sudo apt update
#
#   sudo apt install \
#       fzf \
#       bat \
#       eza \
#       chafa \
#       mediainfo \
#       7zip \
#       poppler-utils \
#       tree \
#       file \
#       dnsutils \
#       fd-find
#
# MacPorts archive previews: sudo port install 7zip
# Notes:
#
# - chafa:
#     image preview
#
# - bat:
#     text/source preview
#
# - eza:
#     directory preview
#
# - mediainfo:
#     audio/video/image metadata
#
# - sevenzip / 7zip:
#     archive listings using 7zz or 7z
#
# - poppler / poppler-utils:
#     pdftotext
#
# - bind / dnsutils:
#     dig for SSH host preview
#
# ============================================================

emulate -L zsh

setopt pipe_fail

preview_path="${1:-}"

[[ -n "$preview_path" ]] || exit 0

preview_path="${preview_path:A}"

[[ -e "$preview_path" ]] || exit 0

typeset -i cols="${FZF_PREVIEW_COLUMNS:-80}"
typeset -i lines="${FZF_PREVIEW_LINES:-40}"

# ============================================================
# Directory
# ============================================================

if [[ -d "$preview_path" ]]; then

    if (( $+commands[eza] )); then

        eza \
            --color=always \
            --icons=always \
            --group-directories-first \
            --git \
            --git-ignore \
            --tree \
            --level=3 \
            -a \
            -- "$preview_path"

    elif (( $+commands[tree] )); then

        tree \
            -a \
            -C \
            -L 3 \
            --gitignore \
            -- "$preview_path"

    else

        command ls -la -- "$preview_path"

    fi

    exit 0
fi

# ============================================================
# MIME detection
# ============================================================

mime="$(
    file \
        -Lb \
        --mime-type \
        -- "$preview_path" \
        2>/dev/null
)"

# ============================================================
# Preview
# ============================================================

case "$mime" in

    # --------------------------------------------------------
    # Images
    # --------------------------------------------------------

    image/*)

        if (( $+commands[chafa] )); then

            typeset -i image_lines=$(( lines - 6 ))

            (( image_lines < 10 )) &&
                image_lines=10

            chafa \
                --format=symbols \
                --animate=off \
                --size="${cols}x${image_lines}" \
                -- "$preview_path"

        fi
        ;;

    # --------------------------------------------------------
    # Video
    # --------------------------------------------------------

    video/*)

        if (( $+commands[mediainfo] )); then

            mediainfo -- "$preview_path"

        else

            file -- "$preview_path"

        fi
        ;;

    # --------------------------------------------------------
    # Audio
    # --------------------------------------------------------

    audio/*)

        if (( $+commands[mediainfo] )); then

            mediainfo -- "$preview_path"

        else

            file -- "$preview_path"

        fi
        ;;

    # --------------------------------------------------------
    # Text / source
    # --------------------------------------------------------

    text/*|\
    application/json|\
    application/xml|\
    application/javascript|\
    application/x-javascript|\
    application/x-shellscript|\
    application/x-yaml|\
    application/yaml|\
    application/toml)

        if (( $+commands[bat] )); then

            bat \
                --color=always \
                --style=numbers \
                --paging=never \
                --line-range=:500 \
                -- "$preview_path"

        elif (( $+commands[batcat] )); then

            batcat \
                --color=always \
                --style=numbers \
                --paging=never \
                --line-range=:500 \
                -- "$preview_path"

        else

            sed -n '1,500p' "$preview_path"

        fi
        ;;

    # --------------------------------------------------------
    # PDF
    # --------------------------------------------------------

    application/pdf)

        if (( $+commands[pdftotext] )); then

            pdftotext \
                "$preview_path" \
                - \
                2>/dev/null |
                head -n 300

        elif (( $+commands[mediainfo] )); then

            mediainfo -- "$preview_path"

        else

            file -- "$preview_path"

        fi
        ;;

    # --------------------------------------------------------
    # Archives
    # --------------------------------------------------------

    application/zip|\
    application/x-zip|\
    application/x-zip-compressed|\
    application/x-7z-compressed|\
    application/vnd.rar|\
    application/x-rar|\
    application/x-rar-compressed|\
    application/x-tar|\
    application/x-gtar|\
    application/gzip|\
    application/x-gzip|\
    application/x-xz|\
    application/x-bzip|\
    application/x-bzip2)

        archiver=${commands[7zz]:-${commands[7z]:-}}
        if [[ -z $archiver ]]; then
            print -r -- '7-Zip is required for archive previews (7zz or 7z).'
            exit 0
        fi

        case $mime in
            application/gzip|application/x-gzip|application/x-xz|application/x-bzip|application/x-bzip2)
                # List a compressed TAR in memory. A single compressed file
                # falls through to the ordinary container listing below.
                # Forced TAR parsing accepts some short non-TAR streams as
                # empty archives, so inspect the decompressed header first.
                inner_mime=$(
                    # file can close its pipe after reading the header.
                    setopt no_pipe_fail
                    "$archiver" x -so -bd -p- -- "$preview_path" </dev/null 2>/dev/null |
                        file -b --mime-type - 2>/dev/null
                )
                if [[ $inner_mime == application/x-tar || $inner_mime == application/x-gtar ]]; then
                    if archive_listing=$(
                        "$archiver" x -so -bd -p- -- "$preview_path" </dev/null 2>/dev/null |
                            "$archiver" l -ba -bd -p- -si -ttar 2>/dev/null |
                            awk 'NR <= 300'
                    ); then
                        print -r -- "$archive_listing"
                        exit 0
                    fi
                fi
                ;;
        esac

        # A supplied password prevents interactive prompts for encrypted
        # headers. -ba keeps only member rows and their available metadata.
        # Drain the listing so truncation cannot cause SIGPIPE errors.
        if archive_listing=$(
            "$archiver" l -ba -bd -p- -- "$preview_path" </dev/null 2>/dev/null |
                awk 'NR <= 300'
        ); then
            print -r -- "$archive_listing"
        else
            print -r -- 'Archive preview unavailable (corrupt, encrypted, or unsupported archive).'
        fi
        ;;

    # --------------------------------------------------------
    # Other
    # --------------------------------------------------------

    *)

        if (( $+commands[mediainfo] )); then

            mediainfo \
                -- "$preview_path" \
                2>/dev/null ||
                file -- "$preview_path"

        else

            file -- "$preview_path"

        fi
        ;;

esac
