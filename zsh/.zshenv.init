
if [[ -f ${HOME}/.z4h-zprof-enabled ]]; then
  zmodload zsh/zprof
fi

if [ -n "${ZSH_VERSION-}" ]; then
  export Z4H_PROMPT=${Z4H_PROMPT:="powerlevel10k"} # powerlevel10k/ohmyposh/minimal
  export Z4H_SHOW_FASTFETCH=${Z4H_SHOW_FASTFETCH:=first} #false/true/first
  export Z4H_ENABLE_ALLAFINE=false
  export Z4H_USE_FZF_TAB=true
  export Z4H_ENABLE_AUTO_GENCOMP=${Z4H_ENABLE_AUTO_GENCOMP:=true} #true/false
  export Z4H_ENABLE_OH_MY_ZSH=true
  export Z4H_SSH_LOAD_KEY=${Z4H_SSH_LOAD_KEY:=true} #false/true
  export Z4H_SSH_SHOW_KEY=${Z4H_SSH_SHOW_KEY:=true} #false/true
  export Z4H_SSH_ASKPASS_REQUIRE=${Z4H_SSH_ASKPASS_REQUIRE:=false} #false/true
  export Z4H_MISE_REFRESH_SECONDS=${Z4H_MISE_REFRESH_SECONDS:=5} #0 checks every prompt
  export Z4H_USE_MISE=${Z4H_USE_MISE:=true} #true/false
  export Z4H_USE_FZF_FROM_Z4H=false
  
  export DOTFILES_DIR="$HOME/.dotfiles" #${DOTFILES_DIR:="$HOME/.dotfiles"}
  export XDG_CACHE_HOME=${XDG_CACHE_HOME:="$HOME/.cache"}
  export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:="$HOME/.config"}
  export XDG_DATA_HOME=${XDG_DATA_HOME:="$HOME/.local/share"} 
  export ZDOTDIR="$DOTFILES_DIR/zsh/home"
  export HISTFILE="$HOME/.local/state/zsh/history"
  export HISTORY_IGNORE="(cd ..|l[s]#( *)#|pwd *|exit *|date *|* --help)"
  export ZSH_COMPDUMP=${ZSH_COMPDUMP:="$XDG_CACHE_HOME/zsh/.zcompdump-${HOST}-${ZSH_VERSION}"}

  # macOS may start Zsh without loading the user's login profile.
  # Keep Homebrew available before the interactive tool bootstrap runs.
  if [[ $OSTYPE == darwin* ]]; then
    path=(/opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin /usr/local/sbin $path)
  fi
  path=("$HOME/.local/bin" $path)
  typeset -gU path PATH
  rehash

  
  

  case ${EDITOR:-} in
    vim|nano|fresh|micro) ;;
    *) EDITOR=micro ;;
  esac
  export EDITOR=${EDITOR:="micro"}
  export VISUAL="$EDITOR"

  export VIMINIT='source ~/.config/vim/vimrc'

  source "$DOTFILES_DIR/zsh/helpers/tool-bootstrap.zsh"

  ## customize your color scheme and keep them in sync
  ## across Linux and OS X/*BSD at http://geoff.greer.fm/lscolors/
  #++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  if [[ -z ${LSCOLORS-} ]]; then
    export LSCOLORS='Exfxcxdxbxegedabagacad'
  fi
  if [[ -z ${LS_COLORS-} ]]; then
    export LS_COLORS='di=1;34;40:ln=35;40:so=32;40:pi=33;40:ex=31;40:bd=34;46:cd=34;43:su=0;41:sg=0;46:tw=0;42:ow=0;43:'
  fi

  # Fix weirdness with intellij
  if [[ -z "${INTELLIJ_ENVIRONMENT_READER}" ]]; then
    export POWERLEVEL9K_INSTANT_PROMPT='quiet'
  fi

  ## JAVA setup
  if [ -d /Library/Java/Home ];then
    export JAVA_HOME=/Library/Java/Home
  fi

  if (( $+commands[rg] )); then
    export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME}/ripgrep/ripgreprc"
  fi

  if (( $+commands[bat] )); then
    export BAT_THEME="Solarized (dark)"
  fi
  
  export FZF_COMPLETION_TRIGGER='**' # change ** to whatever you like 
  
  export POWERLEVEL9K_CONFIG_FILE="$DOTFILES_DIR/powerlevel10k/.p10k.zsh" 
  export Z4H_OH_MY_POSH_CONFIG="$DOTFILES_DIR/oh-my-posh/custom.omp.json"
  
  z4h_zshenv="$ZDOTDIR/.zshenv_z4h"
  if [[ ! -s $z4h_zshenv ]]; then
    z4h_zshenv_url='https://raw.githubusercontent.com/romkatv/zsh4humans/v5/.zshenv'
    z4h_zshenv_tmp=$(mktemp "${z4h_zshenv}.tmp.XXXXXX" 2>/dev/null) || z4h_zshenv_tmp=
    if [[ -n $z4h_zshenv_tmp ]]; then
      z4h_zshenv_downloaded=false
      if command -v curl >/dev/null 2>&1 &&
          curl -fsSL -- "$z4h_zshenv_url" >| "$z4h_zshenv_tmp"; then
        z4h_zshenv_downloaded=true
      elif command -v wget >/dev/null 2>&1 &&
          wget -qO- -- "$z4h_zshenv_url" >| "$z4h_zshenv_tmp"; then
        z4h_zshenv_downloaded=true
      fi
      if [[ $z4h_zshenv_downloaded == true && -s $z4h_zshenv_tmp ]]; then
        mv -f -- "$z4h_zshenv_tmp" "$z4h_zshenv"
      else
        rm -f -- "$z4h_zshenv_tmp"
        print -u2 -r -- 'z4h: unable to download .zshenv from zsh4humans.'
      fi
    else
      print -u2 -r -- 'z4h: unable to create a temporary file for .zshenv.'
    fi
  fi
  if [[ -r $z4h_zshenv ]]; then
    . "$z4h_zshenv"
  else
    print -u2 -r -- "z4h: missing $z4h_zshenv"
  fi

  : ${ZDOTDIR:=~}
fi
