
if [[ -f ${HOME}/.dotsh-zprof-enabled ]]; then
  zmodload zsh/zprof
fi

if [ -n "${ZSH_VERSION-}" ]; then
  # Must run before /etc/zprofile, before .zshrc can be loaded.
  setopt no_global_rcs
  [[ ! -o interactive ]] || umask o-w
  export DOTSH_PROMPT=${DOTSH_PROMPT:="powerlevel10k"} # powerlevel10k/ohmyposh/minimal
  export DOTSH_STARTUP_PROFILE_DEFAULT=${DOTSH_STARTUP_PROFILE_DEFAULT:=fast} # fast/default
  case $DOTSH_STARTUP_PROFILE_DEFAULT in
    default|fast) ;;
    *) export DOTSH_STARTUP_PROFILE_DEFAULT=default ;;
  esac
  case ${DOTSH_STARTUP_PROFILE:-$DOTSH_STARTUP_PROFILE_DEFAULT} in
    default|fast) export DOTSH_STARTUP_PROFILE=${DOTSH_STARTUP_PROFILE:-$DOTSH_STARTUP_PROFILE_DEFAULT} ;;
    *) export DOTSH_STARTUP_PROFILE=$DOTSH_STARTUP_PROFILE_DEFAULT ;;
  esac
  export DOTSH_SHOW_FASTFETCH=${DOTSH_SHOW_FASTFETCH:=first} #false/true/first
  export DOTSH_ENABLE_ALLAFINE=false
  export DOTSH_USE_FZF_TAB=true
  export DOTSH_ENABLE_AUTO_GENCOMP=${DOTSH_ENABLE_AUTO_GENCOMP:=true} #true/false
  export DOTSH_ENABLE_OH_MY_ZSH=true
  export DOTSH_SSH_LOAD_KEY=${DOTSH_SSH_LOAD_KEY:=true} #false/true
  export DOTSH_SSH_SHOW_KEY=${DOTSH_SSH_SHOW_KEY:=true} #false/true
  export DOTSH_SSH_ASKPASS_REQUIRE=${DOTSH_SSH_ASKPASS_REQUIRE:=false} #false/true
  export DOTSH_MISE_REFRESH_SECONDS=${DOTSH_MISE_REFRESH_SECONDS:=5} #0 checks every prompt
  export DOTSH_USE_MISE=${DOTSH_USE_MISE:=true} #true/false
  export DOTFILES_INTEL_PACKAGE_MANAGER=${DOTFILES_INTEL_PACKAGE_MANAGER:=homebrew} #macports/homebrew
  
  export DOTFILES_DIR=${DOTFILES_DIR:-$HOME/.dotfiles}
  export XDG_CACHE_HOME=${XDG_CACHE_HOME:="$HOME/.cache"}
  export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:="$HOME/.config"}
  export XDG_DATA_HOME=${XDG_DATA_HOME:="$HOME/.local/share"} 
  export ZDOTDIR="$DOTFILES_DIR/zsh/home"
  export HISTFILE="$HOME/.local/state/zsh/history"
  export HISTORY_IGNORE="(cd ..|l[s]#( *)#|pwd *|exit *|date *|* --help)"
  export ZSH_COMPDUMP=${ZSH_COMPDUMP:="$XDG_CACHE_HOME/zsh/.zcompdump-${HOST}-${ZSH_VERSION}"}

  # macOS may start Zsh without loading the user's login profile.
  # On Intel Macs, use the package manager selected by the installer. When
  # MacPorts is primary, keep Homebrew isolated for the pkgmng coexistence
  # layer.
  if [[ $OSTYPE == darwin* ]]; then
    if [[ $CPUTYPE == x86_64 ]]; then
      if [[ $DOTFILES_INTEL_PACKAGE_MANAGER == homebrew ]]; then
        path=(
          /usr/local/bin /usr/local/sbin
          ${path:#/opt/local/bin}
          ${path:#/opt/local/sbin}
        )
      else
        path=(
          /opt/local/bin /opt/local/sbin
          ${path:#/usr/local/bin}
          ${path:#/usr/local/sbin}
        )
      fi
    else
      path=(/opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin /usr/local/sbin $path)
    fi
  fi
  path=("$HOME/.local/bin" $path)
  typeset -gU path PATH
  typeset -g _DOTSH_PATH_SNAPSHOT="$PATH"

  (( $+commands[python3] )) && alias python='command python3'

  
  

  case ${EDITOR:-} in
    vim|nano|fresh|micro) ;;
    *) EDITOR=micro ;;
  esac
  export EDITOR=${EDITOR:="micro"}
  export VISUAL="$EDITOR"

  export VIMINIT='source ~/.config/vim/vimrc'

  # Dependencies are prepared explicitly by install.sh, never during startup.

  ## customize your color scheme and keep them in sync
  ## across Linux and OS X/*BSD at http://geoff.greer.fm/lscolors/
  #++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
  if [[ -z ${LSCOLORS-} ]]; then
    export LSCOLORS='Exfxcxdxbxegedabagacad'
  fi
  if [[ -z ${LS_COLORS-} ]]; then
    export LS_COLORS='di=1;34;40:ln=35;40:so=32;40:pi=33;40:ex=31;40:bd=34;46:cd=34;43:su=0;41:sg=0;46:tw=0;42:ow=0;43:'
  fi

  # Fix weirdness with intellij
  if [[ -z "${INTELLIJ_ENVIRONMENT_READER}" ]]; then
    export POWERLEVEL9K_INSTANT_PROMPT='quiet'
  fi

  ## JAVA setup
  if [ -d /Library/Java/Home ];then
    export JAVA_HOME=/Library/Java/Home
  fi

  if (( $+commands[rg] )); then
    export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME}/ripgrep/ripgreprc"
  fi

  if (( $+commands[bat] )); then
    export BAT_THEME="Solarized (dark)"
  fi
  
  export FZF_COMPLETION_TRIGGER='**' # change ** to whatever you like 
  
  export POWERLEVEL9K_CONFIG_FILE="$DOTFILES_DIR/powerlevel10k/.p10k.zsh" 
  export DOTSH_OH_MY_POSH_CONFIG="$DOTFILES_DIR/oh-my-posh/custom.omp.json"
  
  : ${ZDOTDIR:=~}
fi
