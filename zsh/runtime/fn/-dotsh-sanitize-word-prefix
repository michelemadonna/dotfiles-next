#!/usr/bin/env zsh

() {
  emulate -L zsh -o extended_glob
  [[ $_dotsh_word_prefix != *('$'|'\') ]] || return
  if [[ $_dotsh_word_prefix == *[A-Z]* ]]; then
    [[ -z ${(@)*:#$_dotsh_word_prefix*} ]] || return
  else
    [[ -z ${(@)*:#(#i)$_dotsh_word_prefix*} ]] || return
  fi
} "$@" || _dotsh_word_prefix=
_dotsh_word_prefix=${_dotsh_word_prefix// /\\ }
