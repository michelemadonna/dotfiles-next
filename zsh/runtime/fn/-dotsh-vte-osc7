#!/usr/bin/env zsh
#
# The original __vte_osc7 looks like this:
#
#   __vte_osc7 () {
#     printf "\033]7;file://%s%s\033\\" "${HOSTNAME}" "$(/usr/libexec/vte-urlencode-cwd)"
#   }
#
# It runs on precmd.

emulate -L zsh -o no_multi_byte -o extended_glob

if [[ $PWD == /* && $PWD -ef . ]]; then
  local cwd=$PWD
else
  local cwd=${${:-.}:a}
fi
local host=$HOST
[[ -n $cwd && $host != *$'\e'* ]] || return

if [[ $cwd != $_dotsh_vte_last_cwd ]]; then
  local MATCH MBEGIN MEND
  typeset -g _dotsh_vte_last_encoded_cwd=${cwd//(#m)[^a-zA-Z0-9"\/:_.-!'()~"]/%${(l:2::0:)$(([##16]#MATCH))}}
  typeset -g _dotsh_vte_last_cwd=$cwd
elif [[ $host == ${_dotsh_vte_last_host-} && ${_dotsh_iterm_cmd:-0} == 1 &&
        ${_dotsh_terminal_dirty:-0} == 0 ]] &&
     (( ! ${#jobstates} )); then
  return 0
fi

-dotsh-tmux-bypass '\e]7;file://%s%s\e\' "$host" "$_dotsh_vte_last_encoded_cwd"
typeset -g _dotsh_vte_last_host=$host
