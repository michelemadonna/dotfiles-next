#!/usr/bin/env zsh

function iterm2_set_user_var() {
  (( ${+commands[base64]} )) || return
  local x
  x="$(printf '%s' "$2" | command base64 2>/dev/null)" || return
  -dotsh-tmux-bypass '\e]1337;SetUserVar=%s=%s\007' "$1" "${x//$'\n'}"
}

if (( ! $+functions[iterm2_print_user_vars] )); then
  function iterm2_print_user_vars() { }
fi

function -dotsh-iterm2-dump() {
  # I don't know what iTerm2 wants to be escaped and how. The official shell
  # integration doesn't escape anything, which is clearly wrong because \a
  # obviously cannot be passed as is.
  if [[ $PWD == /* && $PWD -ef . ]]; then
    local cwd=$PWD
  else
    local cwd=${${:-.}:a}
  fi
  local user=${(%):-%n} host=${iterm2_hostname:-${(%):-%m}}
  # Empty accepted lines cannot change terminal metadata. Publish it again
  # after every executed command, directory/identity change, or active job.
  if [[ ${2-} == reuse && $_dotsh_iterm_cmd == 1 && ${_dotsh_terminal_dirty:-0} == 0 &&
        $cwd == ${_dotsh_iterm_last_cwd-} && $host == ${_dotsh_iterm_last_host-} &&
        $user == ${_dotsh_iterm_last_user-} ]] && (( ! ${#jobstates} )); then
    [[ -z ${1-} ]] || -dotsh-tmux-bypass '%s' "$1"
    iterm2_print_user_vars
    return
  fi
  # Publish command boundaries and metadata in their original order, together.
  -dotsh-tmux-bypass '%s\e]1337;RemoteHost=%s@%s\a\e]1337;CurrentDir=%s\a' \
    "${1-}" "$user" "$host" "${${cwd//$'\a'/\\a}//$'\e'/\\e}"
  typeset -g _dotsh_iterm_last_cwd=$cwd _dotsh_iterm_last_host=$host _dotsh_iterm_last_user=$user
  iterm2_print_user_vars
}

function -dotsh-iterm2-precmd() {
  zle && return
  local boundary=
  if (( _dotsh_iterm_cmd )); then
    builtin printf -v boundary '\e]133;D;%s\a' "$1"
    (( _dotsh_iterm_cmd != 1 )) || boundary=$'\e]133;C;\a'$boundary
  fi
  -dotsh-iterm2-dump "$boundary" reuse
  typeset -gi _dotsh_iterm_cmd=1
}

function -dotsh-iterm2-preexec() {
  -dotsh-tmux-bypass '\e]133;C;\a'
  typeset -gi _dotsh_iterm_cmd=2
}

typeset -g ITERM_SHELL_INTEGRATION_INSTALLED=Yes
# Expose the conventional integration callback. Powerlevel10k recognizes this
# public interface and leaves command-boundary markers to this runtime.
function iterm2_precmd() { -dotsh-iterm2-precmd "$@" }
typeset -gi _dotsh_iterm_cmd=0

unfunction -- -dotsh-enable-iterm2-integration
autoload -Uz -- -dotsh-enable-iterm2-integration
